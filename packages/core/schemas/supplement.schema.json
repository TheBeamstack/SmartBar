{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rebarconfig/schemas/supplement.schema.json",
  "title": "SupplementManifest",
  "description": "Supplemental reinforcement add-on (spec §5.5 [REF-SHAPE-540]).",
  "type": "object",
  "required": ["id", "role", "shape"],
  "additionalProperties": true,
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "label_fr": { "type": "string" },
    "label_en": { "type": "string" },
    "role": { "enum": ["SUPPLEMENTAL", "SKIN", "DOWEL"] },
    "shape": { "type": "string", "minLength": 1 },
    "requires": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "hostRole": { "type": "string" },
        "min_bars": { "type": "integer", "minimum": 0 }
      }
    },
    "placement": { "type": "object" },
    "params": { "type": "array" },
    "validation": { "type": "array", "items": { "type": "string" } }
  }
}
