{
  "id": "U_BAR",
  "label_fr": "Étrier ouvert en U",
  "label_en": "Open U-bar / U-stirrup",
  "plane": "2D",
  "closed": false,
  "params": [
    { "key": "h", "label_fr": "Hauteur des branches", "label_en": "Leg height", "type": "length", "min": 0, "default": 300 },
    { "key": "w", "label_fr": "Largeur entre branches", "label_en": "Inner width", "type": "length", "min": 0, "default": 1500 }
  ],
  "segments": [
    { "line": "h", "dir": "v+" },
    { "turn": 90, "hand": "right" },
    { "line": "w" },
    { "turn": 90, "hand": "right" },
    { "line": "h" }
  ],
  "endHooks": { "start": "none", "end": "none" },
  "mandrelRule": "code.mandrelMin(diameter)",
  "totalLengthExpr": "2*h + w + hookAllowances - bendDeductions",
  "totalLengthParam": "w",
  "bendDeductionRule": "code.bendDeduction"
}
