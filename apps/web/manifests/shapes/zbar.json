{
  "id": "Z_BAR",
  "label_fr": "Barre en Z (décalée)",
  "label_en": "Z-bar (offset)",
  "plane": "2D",
  "closed": false,
  "params": [
    { "key": "run1", "label_fr": "Tronçon inférieur", "label_en": "Lower run", "type": "length", "min": 0, "default": 500 },
    { "key": "riser", "label_fr": "Tronçon de décalage", "label_en": "Offset run", "type": "length", "min": 0, "default": 200 },
    { "key": "run2", "label_fr": "Tronçon supérieur", "label_en": "Upper run", "type": "length", "min": 0, "default": 500 },
    { "key": "angle", "label_fr": "Angle de pliage", "label_en": "Bend angle", "type": "angle", "min": 0, "max": 90, "default": 90 }
  ],
  "segments": [
    { "line": "run1", "dir": "u+" },
    { "turn": "angle", "hand": "left" },
    { "line": "riser" },
    { "turn": "angle", "hand": "right" },
    { "line": "run2" }
  ],
  "endHooks": { "start": "none", "end": "none" },
  "mandrelRule": "code.mandrelMin(diameter)",
  "totalLengthExpr": "run1 + riser + run2 + hookAllowances - bendDeductions",
  "bendDeductionRule": "code.bendDeduction"
}
